            },
            {
                "id": 45,
                "type": "bubble",
                "character": "Agatha",
                "emotion": "default",
                "text": "Oh minha querida, sou eu, a sua tia! Antes que você parta à procura do amor, aqui está uma coisinha para ajudá-la a avançar em sua aventura no Amor Doce!",
                "x": 8,
                "y": 23,
                "maxWidth": 25
            },
